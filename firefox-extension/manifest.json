{
  "manifest_version": 2,
  "name": "topCEC Media Status",
  "version": "0.1.3",
  "license": "GPL-3.0-or-later",
  "description": "Sends active tab titles and media flags to the local topCEC app for TV standby detection.",
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "topcec-media@topcec.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteActivity"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "nativeMessaging",
    "webNavigation",
    "<all_urls>"
  ],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "all_frames": true,
    "match_about_blank": true,
    "js": ["video.js"]
  }],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
