{
  "manifest_version": 2,
  "name": "topCEC Firefox media status",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "description": "Reports only tab audio flags and active window titles to topCEC.",
  "browser_specific_settings": {
    "gecko": {
      "id": "topcec-media@topcec.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
